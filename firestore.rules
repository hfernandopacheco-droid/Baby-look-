rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_config/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }
    match /community_profiles/{profileId} {
      allow read, write: if true;
    }
    match /community_posts/{postId} {
      allow read, write: if true;
    }
    match /community_posts/{postId}/{subcollection=**} {
      allow read, write: if true;
    }
    match /community_follows/{followId} {
      allow read, write: if true;
    }
    match /community_reportes/{reportId} {
      allow read, write: if true;
    }
    match /community_friend_requests/{requestId} {
      allow read, write: if true;
    }
    match /community_friends/{friendId} {
      allow read, write: if true;
    }
    match /community_notifications/{notifId} {
      allow read, write: if true;
    }
    match /community_chat/{chatId}/{document=**} {
      allow read, write: if true;
    }
    match /community_media/{mediaId} {
      allow read, write: if true;
    }
    match /community_media/{mediaId}/{subcollection=**} {
      allow read, write: if true;
    }
  }
}

